[Unit]
Description=Gungnir Virtual Filesystem Daemon
Documentation=https://gitlab.com/exalted6165/gungnir-vfs
Requires=gungnird.socket
After=gungnird.socket

[Service]
Type=exec
ExecStart=%h/.local/bin/gungnird --idle-timeout 0 --seccomp
Restart=on-failure
RestartSec=1s

# Sandboxing and System Hardening
NoNewPrivileges=yes
PrivateTmp=yes
MemoryDenyWriteExecute=no

[Install]
WantedBy=default.target
