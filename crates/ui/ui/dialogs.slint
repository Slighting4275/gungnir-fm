// In-window modal overlays: new folder, delete confirmation, properties, Gungnir VFS
// Inspect, and errors. Rendered inside AppWindow (no extra OS windows), so they show
// in slint-lsp Live-Preview too.

import { LineEdit, ScrollView, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { KeyValue, OpenWithAppItem } from "types.slint";
import { Glyph } from "widgets.slint";

export enum DialogKind {
    none,
    new-folder,
    confirm-delete,
    properties,
    inspect,
    error,
    // A list of clickable choices (Open With).
    choose,
    preview,
    hash,
    connect-server,
    conflict,
    search,
    batch-rename,
    compare-panes,
    compress,
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked;
    height: 30px;
    width: max(84px, t.preferred-width + 28px);
    border-radius: Theme.radius;
    background: primary ? (danger ? Theme.bad : Theme.accent).darker(touch.pressed ? 20% : touch.has-hover ? 8% : 0%)
        : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border-strong;
    t := Text {
        text: root.label;
        color: root.primary ? Theme.text-on-accent : Theme.text;
        font-size: Theme.font-size;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PropertyTabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 30px;
    width: max(100px, t.preferred-width + 24px);
    border-radius: Theme.radius-small;
    background: active ? Theme.overlay : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: 1px;
    border-color: active ? Theme.accent : Theme.border-strong;
    t := Text {
        text: root.label;
        color: root.active ? Theme.text : Theme.text-dim;
        font-size: Theme.font-size;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DialogOverlay inherits Rectangle {
    in property <DialogKind> kind: DialogKind.inspect;
    in property <string> title: "Gungnir VFS Inspect";
    in property <string> message: "gungnir://odin/asgard/project_demo/release_v1/track_02.flac";
    in property <[KeyValue]> rows: [
        { key: "URI", value: "gungnir://odin/asgard/project_demo/release_v1/track_02.flac" },
        { key: "VFS status", value: "synced" },
        { key: "gungnir::node", value: "odin" },
        { key: "gungnir::replicas", value: "odin,huginn" },
        { key: "gungnir::content-hash", value: "9e3779b97f4a7c15deadbeef00c0ffee" },
        { key: "metadata::emblems", value: "[important, viking]" },
    ];
    in-out property <string> input;
    in property <image> preview-image;
    in property <string> preview-detail;
    in-out property <bool> opt1: false;
    in-out property <bool> opt2: false;
    in-out property <string> extra1: "";
    in-out property <string> extra2: "";
    in-out property <int> properties-tab: 0;
    in property <[OpenWithAppItem]> open-with-apps: [];
    in-out property <int> selected-app-index: -1;
    in-out property <string> custom-command: "";
    in property <string> mime-type: "";
    in property <string> mime-desc: "";
    in property <string> perms-owner: "";
    in property <string> perms-group: "";
    in property <string> perms-others: "";
    in-out property <bool> perms-executable: false;
    callback accept(text: string);
    callback cancel();
    callback choose(index: int);
    callback custom-action(action: string);

    public function focus-input() {
        field.focus();
        field.select-all();
    }

    visible: kind != DialogKind.none;
    background: #00000099;

    // Swallow clicks outside the card; click on the backdrop cancels.
    TouchArea {
        clicked => { root.cancel(); }
    }

    card := Rectangle {
        width: min(parent.width - 48px, root.kind == DialogKind.preview || root.kind == DialogKind.conflict || root.kind == DialogKind.search || root.kind == DialogKind.batch-rename || root.kind == DialogKind.compare-panes || root.kind == DialogKind.compress ? 720px : root.kind == DialogKind.properties || root.kind == DialogKind.inspect || root.kind == DialogKind.hash ? 640px : 440px);
        height: layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: max(24px, (parent.height - self.height) / 2.4);
        border-radius: 10px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { } // clicks inside the card do not cancel

        layout := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Glyph {
                    y: (parent.height - self.height) / 2;
                    name: root.kind == DialogKind.hash ? "edit" : root.kind == DialogKind.connect-server ? "desktop" : root.kind == DialogKind.preview ? "image" : root.kind == DialogKind.inspect ? "spear" : root.kind == DialogKind.confirm-delete ? "trash" : root.kind == DialogKind.new-folder ? "folder" : root.kind == DialogKind.conflict ? "warning" : root.kind == DialogKind.search ? "search" : root.kind == DialogKind.batch-rename ? "edit" : root.kind == DialogKind.compare-panes ? "split" : root.kind == DialogKind.compress ? "download" : "document";
                    tint: root.kind == DialogKind.hash ? Theme.accent : root.kind == DialogKind.preview ? Theme.accent : root.kind == DialogKind.inspect ? Theme.gold : root.kind == DialogKind.error || root.kind == DialogKind.confirm-delete || root.kind == DialogKind.conflict ? Theme.bad : Theme.accent;
                }
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-size-large;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.kind == DialogKind.properties: HorizontalLayout {
                spacing: 8px;
                alignment: center;
                PropertyTabButton {
                    label: "Basic";
                    active: root.properties-tab == 0;
                    clicked => {
                        root.properties-tab = 0;
                        root.custom-action("tab-0");
                    }
                }
                PropertyTabButton {
                    label: "Permissions";
                    active: root.properties-tab == 1;
                    clicked => {
                        root.properties-tab = 1;
                        root.custom-action("tab-1");
                    }
                }
                PropertyTabButton {
                    label: "Open With";
                    active: root.properties-tab == 2;
                    clicked => {
                        root.properties-tab = 2;
                        root.custom-action("tab-2");
                    }
                }
            }
            if root.kind == DialogKind.preview: VerticalLayout {
                alignment: center;
                spacing: 10px;
                if root.preview-image.width > 0: Image {
                    source: root.preview-image;
                    max-width: 640px;
                    max-height: 400px;
                    image-fit: contain;
                    horizontal-alignment: center;
                }
                if root.preview-detail != "": Text {
                    text: root.preview-detail;
                    color: Theme.text-dim;
                    font-size: Theme.font-size;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if root.kind == DialogKind.properties && root.properties-tab == 0 && root.preview-image.width > 0: HorizontalLayout {
                alignment: center;
                padding-bottom: 6px;
                Image {
                    source: root.preview-image;
                    max-width: 220px;
                    max-height: 140px;
                    image-fit: contain;
                }
            }
            if root.message != "" && (root.kind != DialogKind.properties || root.properties-tab == 0): Text {
                text: root.message;
                color: root.kind == DialogKind.error ? Theme.bad.brighter(20%) : Theme.text-dim;
                font-size: Theme.font-size;
                wrap: word-wrap;
            }
            field := LineEdit {
                visible: root.kind == DialogKind.new-folder || root.kind == DialogKind.connect-server || root.kind == DialogKind.hash;
                height: (root.kind == DialogKind.new-folder || root.kind == DialogKind.connect-server || root.kind == DialogKind.hash) ? 32px : 0px;
                text <=> root.input;
                placeholder-text: root.kind == DialogKind.new-folder ? "Folder name" : root.kind == DialogKind.connect-server ? "sftp://user@host/path or smb://host/share" : "Paste expected hash to verify…";
                accepted(t) => { root.accept(t); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.cancel();
                        return EventResult.accept;
                    }
                    EventResult.reject
                }
            }
            if root.kind == DialogKind.hash: VerticalLayout {
                spacing: 6px;
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-small;
                    background: root.input == "" ? transparent : (root.input.to-lowercase() == root.rows[0].value.to-lowercase() || root.input.to-lowercase() == root.rows[1].value.to-lowercase() || root.input.to-lowercase() == root.rows[2].value.to-lowercase() || root.input.to-lowercase() == root.rows[3].value.to-lowercase()) ? #166534 : #991b1b;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;
                        Text {
                            y: (parent.height - self.height) / 2;
                            text: root.input == "" ? "Paste an expected hash in the box above to verify against computed checksums." : (root.input.to-lowercase() == root.rows[0].value.to-lowercase() || root.input.to-lowercase() == root.rows[1].value.to-lowercase() || root.input.to-lowercase() == root.rows[2].value.to-lowercase() || root.input.to-lowercase() == root.rows[3].value.to-lowercase()) ? "✓ VERIFIED MATCH: Hash matches file contents!" : "✗ MISMATCH: Hash does not match any computed checksum.";
                            color: root.input == "" ? Theme.text-dim : #ffffff;
                            font-size: Theme.font-size;
                            font-weight: root.input == "" ? 400 : 600;
                        }
                    }
                }
            }
            if root.kind == DialogKind.conflict: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: root.opt1 ? Theme.accent : Theme.border-strong;
                        background: root.opt1 ? Theme.accent : Theme.field;
                        Text {
                            text: root.opt1 ? "✓" : "";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.opt1 = !root.opt1; } }
                    }
                    Text {
                        text: "Apply this decision to all remaining conflicts in this transfer";
                        color: Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        TouchArea { clicked => { root.opt1 = !root.opt1; } }
                    }
                }
            }
            if root.kind == DialogKind.search: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.extra1;
                        placeholder-text: "Search filename pattern (e.g. *.rs) or text content...";
                        horizontal-stretch: 1;
                        accepted(t) => { root.custom-action("search"); }
                    }
                    DialogButton {
                        label: "Find";
                        primary: true;
                        clicked => { root.custom-action("search"); }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.opt1 ? Theme.accent : Theme.border-strong;
                            background: root.opt1 ? Theme.accent : Theme.field;
                            Text {
                                text: root.opt1 ? "✓" : "";
                                color: #ffffff;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.opt1 = !root.opt1; } }
                        }
                        Text {
                            text: "Grep inside file contents";
                            color: Theme.text-dim;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            TouchArea { clicked => { root.opt1 = !root.opt1; } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.opt2 ? Theme.accent : Theme.border-strong;
                            background: root.opt2 ? Theme.accent : Theme.field;
                            Text {
                                text: root.opt2 ? "✓" : "";
                                color: #ffffff;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.opt2 = !root.opt2; } }
                        }
                        Text {
                            text: "Case sensitive";
                            color: Theme.text-dim;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            TouchArea { clicked => { root.opt2 = !root.opt2; } }
                        }
                    }
                }
            }
            if root.kind == DialogKind.batch-rename: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.extra1;
                        placeholder-text: "Find text or numbering prefix...";
                        horizontal-stretch: 1;
                        edited(t) => { root.custom-action("preview-rename"); }
                    }
                    LineEdit {
                        text <=> root.extra2;
                        placeholder-text: "Replace with (or start index e.g. 1)...";
                        horizontal-stretch: 1;
                        edited(t) => { root.custom-action("preview-rename"); }
                    }
                }
            }
            if root.kind == DialogKind.compress: VerticalLayout {
                spacing: 12px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Archive Name:";
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                    }
                    LineEdit {
                        height: 32px;
                        text <=> root.input;
                        placeholder-text: "archive.tar.zst";
                        accepted(t) => { root.accept(t); }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Lossless Format (Strict 100% Bit-Perfect):";
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        DialogButton {
                            label: ".tar.zst (Zstandard)";
                            primary: root.extra1 == "tar.zst" || root.extra1 == "";
                            clicked => { root.extra1 = "tar.zst"; }
                        }
                        DialogButton {
                            label: ".zip (Universal)";
                            primary: root.extra1 == "zip";
                            clicked => { root.extra1 = "zip"; }
                        }
                        DialogButton {
                            label: ".tar.xz (LZMA2)";
                            primary: root.extra1 == "tar.xz";
                            clicked => { root.extra1 = "tar.xz"; }
                        }
                        DialogButton {
                            label: ".7z (7-Zip)";
                            primary: root.extra1 == "7z";
                            clicked => { root.extra1 = "7z"; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        DialogButton {
                            label: ".tar.gz (Gzip)";
                            primary: root.extra1 == "tar.gz";
                            clicked => { root.extra1 = "tar.gz"; }
                        }
                        DialogButton {
                            label: ".tar.bz2 (Bzip2)";
                            primary: root.extra1 == "tar.bz2";
                            clicked => { root.extra1 = "tar.bz2"; }
                        }
                        DialogButton {
                            label: ".tar.lz4 (Ultra-Fast)";
                            primary: root.extra1 == "tar.lz4";
                            clicked => { root.extra1 = "tar.lz4"; }
                        }
                        DialogButton {
                            label: ".tar";
                            primary: root.extra1 == "tar";
                            clicked => { root.extra1 = "tar"; }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Compression Level:";
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        DialogButton {
                            label: "Fast";
                            primary: root.opt1;
                            clicked => { root.opt1 = true; root.opt2 = false; }
                        }
                        DialogButton {
                            label: "Normal (Default)";
                            primary: !root.opt1 && !root.opt2;
                            clicked => { root.opt1 = false; root.opt2 = false; }
                        }
                        DialogButton {
                            label: "Maximum (Ultra)";
                            primary: root.opt2;
                            clicked => { root.opt1 = false; root.opt2 = true; }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Optional Encryption Password (AES-256 for 7z / ZIP):";
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: 600;
                    }
                    LineEdit {
                        height: 32px;
                        text <=> root.extra2;
                        placeholder-text: "Leave blank for unencrypted archive";
                        input-type: password;
                        accepted(t) => { root.accept(root.input); }
                    }
                }
            }
            if root.kind == DialogKind.choose || (root.kind == DialogKind.search && root.rows.length > 0): Rectangle {
                height: min(400px, root.rows.length * 40px + 8px);
                border-radius: Theme.radius;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.border;
                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        for r[i] in root.rows: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-small;
                            background: pick.pressed ? Theme.pressed : pick.has-hover ? Theme.selection : transparent;
                            pick := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.choose(i); }
                            }
                            VerticalLayout {
                                padding-left: 10px;
                                alignment: center;
                                Text { text: r.key; color: Theme.text; font-size: Theme.font-size; font-weight: i == 0 ? 600 : 400; }
                                Text { text: r.value; color: Theme.text-faint; font-size: 11px; }
                            }
                        }
                    }
                }
            }
            if root.rows.length > 0 && root.kind != DialogKind.choose && root.kind != DialogKind.search && (root.kind != DialogKind.properties || root.properties-tab == 0): Rectangle {
                // Values wrap (long URIs), so size by row count rather than the unwrapped estimate.
                height: min(400px, max(rows-layout.preferred-height + 2px, root.rows.length * 30px + 18px));
                border-radius: Theme.radius;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.border;
                ScrollView {
                    rows-layout := VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        for r in root.rows: HorizontalLayout {
                            spacing: 14px;
                            Text {
                                width: 150px;
                                text: r.key;
                                color: Theme.gold.darker(8%);
                                font-size: Theme.font-size-small;
                                overflow: elide;
                            }
                            TextInput {
                                text: r.value;
                                read-only: true;
                                color: Theme.text;
                                font-size: Theme.font-size-small;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                single-line: false;
                            }
                        }
                    }
                }
            }
            if root.kind == DialogKind.properties && root.properties-tab == 1: Rectangle {
                height: 250px;
                border-radius: Theme.radius;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: "File Ownership & Access Control";
                        font-size: Theme.font-size;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 80px;
                            text: "Owner:";
                            color: Theme.gold.darker(8%);
                            font-weight: 600;
                            font-size: Theme.font-size;
                        }
                        Text {
                            text: root.perms-owner;
                            color: Theme.text;
                            font-size: Theme.font-size;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 80px;
                            text: "Group:";
                            color: Theme.gold.darker(8%);
                            font-weight: 600;
                            font-size: Theme.font-size;
                        }
                        Text {
                            text: root.perms-group;
                            color: Theme.text;
                            font-size: Theme.font-size;
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            width: 80px;
                            text: "Others:";
                            color: Theme.gold.darker(8%);
                            font-weight: 600;
                            font-size: Theme.font-size;
                        }
                        Text {
                            text: root.perms-others;
                            color: Theme.text;
                            font-size: Theme.font-size;
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: root.perms-executable ? Theme.accent : Theme.border-strong;
                            background: root.perms-executable ? Theme.accent : Theme.field;
                            Text {
                                text: root.perms-executable ? "✓" : "";
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.perms-executable = !root.perms-executable; } }
                        }
                        Text {
                            text: "Allow executing file as program";
                            color: Theme.text;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            TouchArea { clicked => { root.perms-executable = !root.perms-executable; } }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        DialogButton {
                            label: "Apply Permissions";
                            primary: true;
                            clicked => {
                                root.custom-action("apply-permissions:" + (root.perms-executable ? "exec" : "noexec"));
                            }
                        }
                    }
                }
            }
            if root.kind == DialogKind.properties && root.properties-tab == 2: VerticalLayout {
                spacing: 10px;
                Text {
                    text: "Select an application in the list to open\n" + root.input + " and other files of type \"" + (root.mime-desc != "" ? root.mime-desc : root.mime-type) + "\"";
                    color: Theme.text;
                    font-size: Theme.font-size;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 240px;
                    border-radius: Theme.radius;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.border;
                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            for app[i] in root.open-with-apps: Rectangle {
                                height: app.is-header ? 28px : 36px;
                                border-radius: Theme.radius-small;
                                background: app.is-header ? transparent : (i == root.selected-app-index ? #1d4ed8 : item-touch.has-hover ? Theme.hover : transparent);

                                if app.is-header: HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: start;
                                    Text {
                                        text: app.name;
                                        color: Theme.text;
                                        font-size: Theme.font-size;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                if !app.is-header: HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: start;
                                    Glyph {
                                        y: (parent.height - self.height) / 2;
                                        name: app.icon != "" ? app.icon : "desktop";
                                        tint: i == root.selected-app-index ? #ffffff : Theme.accent;
                                    }
                                    Text {
                                        text: app.name;
                                        color: i == root.selected-app-index ? #ffffff : Theme.text;
                                        font-size: Theme.font-size;
                                        font-weight: app.is-default ? 600 : 400;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if app.is-default: Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 18px;
                                        width: badge-t.preferred-width + 12px;
                                        border-radius: 9px;
                                        background: i == root.selected-app-index ? #ffffff33 : Theme.accent.with-alpha(0.2);
                                        border-width: 1px;
                                        border-color: i == root.selected-app-index ? #ffffff66 : Theme.accent.with-alpha(0.6);
                                        badge-t := Text {
                                            text: "Default";
                                            color: i == root.selected-app-index ? #ffffff : Theme.accent;
                                            font-size: 10px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                item-touch := TouchArea {
                                    enabled: !app.is-header;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected-app-index = i;
                                        root.custom-action("select-app:" + app.id);
                                    }
                                    double-clicked => {
                                        root.selected-app-index = i;
                                        root.custom-action("open-with-app:" + app.id);
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "You can also type or select a custom executable file to use to open this file type. You can use this command just once, or set it as default for all files of this type.";
                    color: Theme.text-dim;
                    font-size: Theme.font-size-small;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    cmd-field := LineEdit {
                        horizontal-stretch: 1;
                        height: 32px;
                        text <=> root.custom-command;
                        placeholder-text: "Custom command or executable path...";
                        accepted(t) => {
                            root.custom-action("open-custom:" + t);
                        }
                    }
                    Rectangle {
                        width: 34px;
                        height: 32px;
                        border-radius: Theme.radius-small;
                        background: browse-touch.pressed ? Theme.pressed : browse-touch.has-hover ? Theme.hover : Theme.field;
                        border-width: 1px;
                        border-color: Theme.border;
                        Glyph {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "folder";
                            tint: Theme.text-dim;
                        }
                        browse-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.custom-action("browse-custom-app"); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    DialogButton {
                        label: "Open";
                        clicked => {
                            if root.custom-command != "" {
                                root.custom-action("open-custom:" + root.custom-command);
                            } else if root.selected-app-index >= 0 && root.selected-app-index < root.open-with-apps.length {
                                root.custom-action("open-with-app:" + root.open-with-apps[root.selected-app-index].id);
                            }
                        }
                    }
                    DialogButton {
                        label: "Set as default";
                        primary: true;
                        clicked => {
                            if root.custom-command != "" {
                                root.custom-action("set-default-custom:" + root.custom-command);
                            } else if root.selected-app-index >= 0 && root.selected-app-index < root.open-with-apps.length {
                                root.custom-action("set-default-app:" + root.open-with-apps[root.selected-app-index].id);
                            }
                        }
                    }
                    DialogButton {
                        label: "Reset to system defaults";
                        clicked => {
                            root.custom-action("reset-default-app");
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.kind == DialogKind.conflict: HorizontalLayout {
                    spacing: 8px;
                    DialogButton {
                        label: "Skip";
                        clicked => { root.custom-action("skip"); }
                    }
                    DialogButton {
                        label: "Auto-Rename";
                        clicked => { root.custom-action("auto-rename"); }
                    }
                    DialogButton {
                        label: "Replace If Newer";
                        clicked => { root.custom-action("replace-if-newer"); }
                    }
                    DialogButton {
                        label: "Replace";
                        primary: true;
                        danger: true;
                        clicked => { root.custom-action("replace"); }
                    }
                }
                if root.kind == DialogKind.search: DialogButton {
                    label: "Close";
                    clicked => { root.cancel(); }
                }
                if root.kind == DialogKind.batch-rename: HorizontalLayout {
                    spacing: 8px;
                    DialogButton {
                        label: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    DialogButton {
                        label: "Rename All";
                        primary: true;
                        clicked => { root.custom-action("apply-batch-rename"); }
                    }
                }
                if root.kind == DialogKind.compare-panes: HorizontalLayout {
                    spacing: 8px;
                    DialogButton {
                        label: "Sync Left → Right";
                        primary: true;
                        clicked => { root.custom-action("sync-left-to-right"); }
                    }
                    DialogButton {
                        label: "Sync Right → Left";
                        primary: true;
                        clicked => { root.custom-action("sync-right-to-left"); }
                    }
                    DialogButton {
                        label: "Close";
                        clicked => { root.cancel(); }
                    }
                }
                if root.kind == DialogKind.compress: HorizontalLayout {
                    spacing: 8px;
                    DialogButton {
                        label: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    DialogButton {
                        label: "Compress";
                        primary: true;
                        clicked => { root.accept(root.input); }
                    }
                }
                if root.kind != DialogKind.conflict && root.kind != DialogKind.search && root.kind != DialogKind.batch-rename && root.kind != DialogKind.compare-panes && root.kind != DialogKind.compress: HorizontalLayout {
                    spacing: 8px;
                    if root.kind == DialogKind.new-folder || root.kind == DialogKind.confirm-delete || root.kind == DialogKind.connect-server: DialogButton {
                        label: "Cancel";
                        clicked => { root.cancel(); }
                    }
                    DialogButton {
                        label: root.kind == DialogKind.new-folder ? "Create" : root.kind == DialogKind.connect-server ? "Connect" : root.kind == DialogKind.confirm-delete ? "Delete" : "Close";
                        primary: true;
                        danger: root.kind == DialogKind.confirm-delete;
                        clicked => {
                            if root.kind == DialogKind.new-folder || root.kind == DialogKind.confirm-delete || root.kind == DialogKind.connect-server {
                                root.accept(root.input);
                            } else {
                                root.cancel();
                            }
                        }
                    }
                }
            }
        }
    }
}
