#!/bin/sh
# Gungnir FM AppImage runtime entrypoint.
# Launches gungnird background daemon, configures GIO dynamic VFS,
# and executes Gungnir FM from the mounted AppDir.
set -eu

# Resolve base AppDir directory
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="$HERE"

export PATH="$APPDIR/usr/bin:$APPDIR/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/gio/modules:$APPDIR/lib:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Standard runtime socket directory (0700 owned by user)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sock="${GUNGNIR_SOCKET:-$XDG_RUNTIME_DIR/gungnir/gungnird.sock}"
mkdir -p "$(dirname "$sock")"
chmod 700 "$(dirname "$sock")" 2>/dev/null || true

# GIO VFS modules and live backend configuration
export GIO_EXTRA_MODULES="$APPDIR/usr/lib/gio/modules:${GIO_EXTRA_MODULES:-}"
export GIO_USE_VFS="gungnir"
export GUNGNIR_FM_BACKEND="live"
export GUNGNIR_PACKAGE_FORMAT="appimage"

# Start gungnird background daemon if not already running
if [ -x "$APPDIR/usr/bin/gungnird" ] && [ ! -S "$sock" ]; then
    "$APPDIR/usr/bin/gungnird" --idle-timeout 300 >/dev/null 2>&1 &
fi

exec "$APPDIR/usr/bin/gungnir-fm" "$@"
