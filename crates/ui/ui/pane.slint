// One file pane: tab strip (active-pane accent), sortable column header and a
// virtualized ListView (only visible rows are instantiated, so 100k+ entries scroll
// smoothly). Three view modes: 0 compact list, 1 detailed columns, 2 grid.

import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FileRow, PaneInfo, TabInfo, CustomActionItem } from "types.slint";
import { FileIcon, Glyph, Dot } from "widgets.slint";

component Tab inherits Rectangle {
    in property <TabInfo> tab;
    in property <bool> current;
    in property <bool> pane-active;
    in property <bool> closable;
    callback select;
    callback close;
    height: 30px;
    width: root.closable ? min(220px, max(110px, title.preferred-width + 52px)) : min(220px, max(80px, title.preferred-width + 24px));
    background: current ? Theme.surface : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle && root.closable {
                root.close();
            }
        }
    }
    // Accent line: active tab of the active pane.
    Rectangle {
        y: 0;
        height: 2px;
        background: root.current ? (root.pane-active ? Theme.accent : Theme.border-strong) : transparent;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        if root.tab.loading: Rectangle {
            width: 8px;
            Rectangle {
                y: (parent.height - 8px) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent.with-alpha(0.4 + 0.6 * abs(sin(animation-tick() / 700ms * 360deg)));
            }
        }
        title := Text {
            text: root.tab.title;
            color: root.current ? Theme.text : Theme.text-dim;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.closable: Rectangle {
            width: 20px;
            opacity: touch.has-hover || close-touch.has-hover ? 1.0 : 0.0;
            animate opacity { duration: 100ms; }
            Rectangle {
                y: (parent.height - 20px) / 2;
                height: 20px;
                border-radius: Theme.radius-small;
                background: close-touch.has-hover ? Theme.pressed : transparent;
                Glyph {
                    name: "close";
                    width: 10px;
                    height: 10px;
                    tint: close-touch.has-hover ? Theme.text : Theme.text-faint;
                }
                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close(); }
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.divider;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> align: left;
    callback clicked(column: int);
    background: touch.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: root.label;
            color: root.sort-column == root.column ? Theme.text : Theme.text-faint;
            font-size: Theme.font-size-small;
            font-weight: root.sort-column == root.column ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: root.align;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.sort-column == root.column: Text {
            text: root.ascending ? "▲" : "▼";
            color: Theme.accent;
            font-size: 8px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(root.column); }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height * 0.5;
        y: parent.height * 0.25;
        background: Theme.divider;
    }
}

export component Pane inherits Rectangle {
    in property <int> pane-index: 0;
    in property <bool> active: true;
    in property <bool> split: false;
    in property <int> view-mode: 1;
    in property <int> renaming-index: -1;
    in property <[CustomActionItem]> custom-actions: [
        { id: "terminal", title: "Open Terminal Here" },
    ];
    in property <PaneInfo> info: {
        tabs: [
            { title: "project_demo", location: "/home/user/Documents/project_demo", loading: false },
            { title: "asgard", location: "gungnir://odin/asgard", loading: true },
        ],
        active-tab: 0,
        location: "/home/user/Documents/project_demo",
        crumbs: [],
        sort-column: 0,
        sort-ascending: true,
        loading: false,
        error: "",
        filter: "",
        can-back: true,
        can-forward: false,
        cursor: 2,
    };
    in property <[FileRow]> files: [
        { name: "release_v1", size-text: "", type-text: "Folder", modified-text: "2026-10-12 21:40", perms-text: "drwxr-xr-x", status-text: "", status: 0, icon: 0, is-dir: true, hidden: false, selected: false },
        { name: "assets", size-text: "", type-text: "Folder", modified-text: "2026-10-20 03:12", perms-text: "drwxr-xr-x", status-text: "synced", status: 1, icon: 0, is-dir: true, hidden: false, selected: false },
        { name: "track_01.flac", size-text: "48.2 MB", type-text: "FLAC audio", modified-text: "2026-10-12 21:44", perms-text: "-rw-r--r--", status-text: "tagged", status: 6, icon: 3, is-dir: false, hidden: false, selected: true },
        { name: "track_02.flac", size-text: "52.0 MB", type-text: "FLAC audio", modified-text: "2026-10-12 21:51", perms-text: "-rw-r--r--", status-text: "syncing", status: 2, icon: 3, is-dir: false, hidden: false, selected: true },
        { name: "track_03.flac", size-text: "44.1 MB", type-text: "FLAC audio", modified-text: "2026-10-12 22:03", perms-text: "-rw-r--r--", status-text: "", status: 0, icon: 3, is-dir: false, hidden: false, selected: false },
        { name: "cover.jpg", size-text: "1.2 MB", type-text: "JPEG image", modified-text: "2026-10-11 18:20", perms-text: "-rw-r--r--", status-text: "remote", status: 4, icon: 2, is-dir: false, hidden: false, selected: false },
        { name: "notes.md", size-text: "4.8 kB", type-text: "Markdown", modified-text: "2026-10-22 09:15", perms-text: "-rw-r--r--", status-text: "conflict", status: 5, icon: 6, is-dir: false, hidden: false, selected: false },
        { name: "build.sh", size-text: "1.1 kB", type-text: "Shell script", modified-text: "2026-10-22 09:30", perms-text: "-rwxr-xr-x", status-text: "", status: 0, icon: 8, is-dir: false, hidden: false, selected: false },
        { name: "demo_video.mkv", size-text: "4.3 GB", type-text: "Matroska video", modified-text: "2026-10-23 23:59", perms-text: "-rw-r--r--", status-text: "cached", status: 3, icon: 4, is-dir: false, hidden: false, selected: false },
        { name: ".mixrc", size-text: "312 bytes", type-text: "File", modified-text: "2026-09-30 12:00", perms-text: "-rw-------", status-text: "", status: 0, icon: 1, is-dir: false, hidden: true, selected: false },
    ];
    in-out property <int> thumbnail-rev: 0;
    in-out property <float> zoom-level: 1.0;

    callback row-clicked(index: int, ctrl: bool, shift: bool);
    callback row-activated(index: int);
    callback row-context(index: int);
    callback sort-by(column: int);
    callback tab-select(index: int);
    callback tab-close(index: int);
    callback tab-new();
    callback zoom-changed(float);
    callback focus-pane();
    callback command(name: string);
    callback custom-action(id: string);
    callback rename-commit(index: int, name: string);
    callback rename-cancel();
    // Drag and drop inside the app: the pane reports where a drag started and where
    // it was dropped (index -1: the pane's own folder).
    in property <bool> dragging-from-app: false;
    in-out property <int> pending-single: -1;
    callback drag-start(index: int);
    callback drag-end();
    callback drop-on(index: int, copy: bool);
    // The drag payload (built by the host; it only names the row, the drop reads the
    // source from drag-start).
    pure callback drag-data(index: int) -> data-transfer;

    property <length> row-h: (root.view-mode == 0 ? Theme.compact-row-height : Theme.row-height) * Math.max(0.9, Math.min(1.4, 0.85 + 0.15 * root.zoom-level));
    property <bool> show-type: list-area.width > 640px;
    property <bool> show-perms: list-area.width > 780px;
    property <bool> show-modified: list-area.width > 500px;
    property <length> size-w: 86px;
    property <length> type-w: root.show-type ? 132px : 0px;
    property <length> modified-w: root.show-modified ? 132px : 0px;
    property <length> perms-w: root.show-perms ? 96px : 0px;
    property <length> status-w: 92px;
    property <length> thumb-size: Math.max(56px, 128px * root.zoom-level);
    property <length> icon-size: Math.max(40px, 80px * root.zoom-level);
    property <length> grid-cell-w: root.thumb-size + 24px;
    property <length> grid-cell-h: root.thumb-size + 44px;
    property <int> grid-cols: Math.max(1, Math.floor(list-area.width / root.grid-cell-w));
    property <int> cursor: root.info.cursor;

    // Keep the keyboard cursor in view.
    changed cursor => {
        if root.view-mode == 2 {
            let row-y = floor(root.cursor / root.grid-cols) * root.grid-cell-h;
            if row-y < -grid.content-y { grid.content-y = -row-y; }
            if row-y + root.grid-cell-h > -grid.content-y + grid.visible-height { grid.content-y = -min(max(0px, grid.content-height - grid.visible-height), row-y + root.grid-cell-h - grid.visible-height); }
        } else {
            // A programmatic content-y is not clamped, so never scroll past the end.
            let max-scroll = max(0px, list.content-height - list.visible-height);
            let y = root.cursor * root.row-h;
            if y < -list.content-y { list.content-y = -y; }
            if y + root.row-h > -list.content-y + list.visible-height { list.content-y = -min(max-scroll, y + root.row-h - list.visible-height); }
        }
    }

    // Flush, edge to edge (no card). In split view the active pane gets a thin accent
    // line on top and the inactive one is dimmed slightly, as in Nemo.
    background: root.split && !root.active ? Theme.base : Theme.surface;
    clip: true;

    if root.split: Rectangle {
        y: 0;
        height: 2px;
        background: root.active ? Theme.accent : transparent;
        z: 10;
    }

    VerticalLayout {
        padding: 0px;
        // Tab strip: always visible, flat and unobtrusive when single tab.
        if root.info.tabs.length >= 1: Rectangle {
            height: root.info.tabs.length > 1 ? 30px : 26px;
            background: Theme.base;
            HorizontalLayout {
                for t[i] in root.info.tabs: Tab {
                    tab: t;
                    current: i == root.info.active-tab;
                    pane-active: root.active;
                    closable: root.info.tabs.length > 1;
                    select => { root.focus-pane(); root.tab-select(i); }
                    close => { root.tab-close(i); }
                }
                Rectangle {
                    width: 28px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-small;
                        background: plus.has-hover ? Theme.hover : transparent;
                        Glyph { name: "plus"; width: 12px; height: 12px; tint: plus.has-hover ? Theme.text : Theme.text-faint; }
                        plus := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.focus-pane(); root.tab-new(); }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // Column header (detailed view).
        if root.view-mode == 1: Rectangle {
            height: 26px;
            min-width: 0px;
            preferred-width: 0px;
            background: Theme.surface;
            // Absolutely positioned (no layout), so the width-dependent columns never feed
            // back into the pane's size constraints.
            property <length> fixed: root.size-w + root.type-w + root.modified-w + root.perms-w + root.status-w + 12px;
            property <length> name-w: max(80px, self.width - 6px - self.fixed);
            HeaderCell { x: 6px; width: parent.name-w; height: parent.height; label: "Name"; column: 0; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            HeaderCell { x: 6px + parent.name-w; width: root.size-w - 6px; height: parent.height; label: "Size"; column: 1; align: right; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            if root.show-type: HeaderCell { x: 6px + parent.name-w + root.size-w; width: root.type-w; height: parent.height; label: "Type"; column: 2; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            if root.show-modified: HeaderCell { x: 6px + parent.name-w + root.size-w + root.type-w; width: root.modified-w; height: parent.height; label: "Modified"; column: 3; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            if root.show-perms: HeaderCell { x: 6px + parent.name-w + root.size-w + root.type-w + root.modified-w; width: root.perms-w; height: parent.height; label: "Permissions"; column: 4; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            HeaderCell { x: 6px + parent.name-w + root.size-w + root.type-w + root.modified-w + root.perms-w; width: root.status-w; height: parent.height; label: "VFS Status"; column: 5; sort-column: root.info.sort-column; ascending: root.info.sort-ascending; clicked(c) => { root.sort-by(c); } }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.divider;
            }
        }

        list-area := Rectangle {
            vertical-stretch: 1;
            // Drops on empty space or on a file go into this pane's folder.
            pane-drop := DropArea {
                can-drop(e) => { root.dragging-from-app ? e.proposed-action : DragAction.none }
                dropped(e) => {
                    root.drop-on(-1, e.proposed-action == DragAction.copy);
                    e.proposed-action
                }
            }
            if pane-drop.has-drag: Rectangle {
                border-width: 2px;
                border-color: Theme.accent-dim;
            }
            cm := ContextMenuArea {
                Menu {
                    MenuItem { title: "Open"; activated => { root.command("open"); } }
                    MenuItem { title: "Open in New Tab"; activated => { root.command("open-in-tab"); } }
                    MenuItem { title: "Open With…"; activated => { root.command("open-with"); } }
                    MenuSeparator { }
                    MenuItem { title: "Cut"; activated => { root.command("cut"); } }
                    MenuItem { title: "Copy"; activated => { root.command("copy"); } }
                    MenuItem { title: "Paste"; activated => { root.command("paste"); } }
                    MenuSeparator { }
                    MenuItem { title: "Copy to Other Pane (F5)"; activated => { root.command("copy-to-other"); } }
                    MenuItem { title: "Move to Other Pane (F6)"; activated => { root.command("move-to-other"); } }
                    MenuItem { title: "Rename… (F2)"; activated => { root.command("rename"); } }
                    MenuItem { title: "New Folder… (F7)"; activated => { root.command("new-folder"); } }
                    MenuSeparator { }
                    MenuItem { title: "Move to Trash"; activated => { root.command("trash"); } }
                    MenuItem { title: "Delete Permanently…"; activated => { root.command("delete"); } }
                    MenuSeparator { }
                    MenuItem { title: "Properties"; activated => { root.command("properties"); } }
                    MenuItem { title: "Check File Hash…"; activated => { root.command("check-hash"); } }
                    MenuItem { title: "Gungnir VFS Inspect"; activated => { root.command("inspect"); } }
                    if root.custom-actions.length > 0: MenuSeparator { }
                    for act in root.custom-actions: MenuItem {
                        title: act.title;
                        activated => { root.custom-action(act.id); }
                    }
                }

                // List views (compact / detailed).
                list := ListView {
                    visible: root.view-mode != 2;
                    for f[idx] in root.files: Rectangle {
                        height: root.row-h;
                        background: f.selected ? (root.active ? Theme.selection : Theme.selection-inactive)
                            : row-touch.has-hover ? Theme.hover
                            : Math.mod(idx, 2) == 1 ? Theme.stripe : transparent;
                        // Keyboard cursor on an unselected row: a faint outline only.
                        border-width: idx == root.info.cursor && root.active && !f.selected ? 1px : 0px;
                        border-color: Theme.border-strong;

                        // Press-and-move drags the row (and the rest of the selection if the row is
                        // selected); a plain click still selects. TouchArea sits inside the DragArea.
                        row-drag := DragArea {
                            allow-copy: true;
                            allow-move: true;
                            data: root.drag-data(idx);
                            changed dragging => {
                                if self.dragging { root.drag-start(idx); } else { root.drag-end(); }
                            }
                        row-touch := TouchArea {
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    root.focus-pane();
                                    if e.button == PointerEventButton.left {
                                        // On an already selected row, wait for the release: this
                                        // press may start dragging the whole selection.
                                        if f.selected && !e.modifiers.control && !e.modifiers.shift {
                                            root.pending-single = idx;
                                        } else {
                                            root.row-clicked(idx, e.modifiers.control, e.modifiers.shift);
                                        }
                                    } else if e.button == PointerEventButton.right {
                                        root.row-context(idx);
                                        cm.show({
                                            x: self.absolute-position.x - cm.absolute-position.x + self.mouse-x,
                                            y: self.absolute-position.y - cm.absolute-position.y + self.mouse-y,
                                        });
                                    }
                                }
                            }
                            clicked => {
                                if root.pending-single == idx {
                                    root.pending-single = -1;
                                    root.row-clicked(idx, false, false);
                                }
                            }
                            double-clicked => { root.row-activated(idx); }
                        }
                        }

                        // Folders accept drops (copy with Ctrl, move otherwise).
                        row-drop := DropArea {
                            enabled: f.is-dir;
                            can-drop(e) => { root.dragging-from-app ? e.proposed-action : DragAction.none }
                            dropped(e) => {
                                root.drop-on(idx, e.proposed-action == DragAction.copy);
                                e.proposed-action
                            }
                        }
                        Rectangle {
                            visible: row-drop.has-drag;
                            border-width: 2px;
                            border-color: Theme.accent;
                            border-radius: Theme.radius-small;
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            spacing: 0px;
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                padding-right: 8px;
                                Image {
                                    visible: f.has-thumbnail;
                                    y: (parent.height - self.height) / 2;
                                    width: f.has-thumbnail ? 18px : 0px;
                                    height: 18px;
                                    source: f.thumbnail;
                                    image-fit: contain;
                                }
                                FileIcon {
                                    visible: !f.has-thumbnail;
                                    y: (parent.height - self.height) / 2;
                                    width: !f.has-thumbnail ? 16px : 0px;
                                    category: f.icon;
                                }
                                if idx != root.renaming-index: Text {
                                    text: f.name;
                                    color: f.hidden ? Theme.text-faint : Theme.text;
                                    font-size: Theme.font-size;
                                    font-weight: f.is-dir ? 500 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if idx == root.renaming-index: LineEdit {
                                    horizontal-stretch: 1;
                                    height: root.row-h - 2px;
                                    y: 1px;
                                    text: f.name;
                                    font-size: Theme.font-size;
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    accepted(t) => { root.rename-commit(idx, t); }
                                    key-pressed(e) => {
                                        if e.text == Key.Escape {
                                            root.rename-cancel();
                                            return accept;
                                        }
                                        reject
                                    }
                                }
                                if root.view-mode == 0 && f.status != 0: Dot {
                                    y: (parent.height - self.height) / 2;
                                    tint: Theme.status-color(f.status);
                                }
                            }
                            if root.view-mode == 1: Text {
                                width: root.size-w - 14px;
                                text: f.size-text;
                                color: Theme.text-dim;
                                font-size: Theme.font-size-small;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            if root.view-mode == 1: Rectangle { width: 14px; }
                            if root.view-mode == 1 && root.show-type: Text {
                                width: root.type-w;
                                text: f.type-text;
                                color: Theme.text-dim;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.view-mode == 1 && root.show-modified: Text {
                                width: root.modified-w;
                                text: f.modified-text;
                                color: Theme.text-dim;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                            }
                            if root.view-mode == 1 && root.show-perms: Text {
                                width: root.perms-w;
                                text: f.perms-text;
                                color: Theme.text-faint;
                                font-family: "monospace";
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                            }
                            if root.view-mode == 1: HorizontalLayout {
                                width: root.status-w;
                                spacing: 6px;
                                padding-left: 6px;
                                if f.status != 0: Dot {
                                    y: (parent.height - self.height) / 2;
                                    tint: Theme.status-color(f.status);
                                }
                                Text {
                                    text: f.status-text;
                                    color: Theme.status-color(f.status);
                                    font-size: Theme.font-size-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.view-mode == 1: Rectangle { width: 12px; }
                        }
                    }
                }

                // Grid view: virtualized rows of `grid-cols` cells.
                grid := ListView {
                    visible: root.view-mode == 2;
                    property <int> rev: root.thumbnail-rev;
                    for r in (root.view-mode == 2 ? ceil(root.files.length / root.grid-cols) : 0): HorizontalLayout {
                        height: root.grid-cell-h;
                        padding-left: 6px;
                        spacing: 0px;
                        for c in root.grid-cols: cell := Rectangle {
                            property <int> rev: root.thumbnail-rev;
                            property <int> idx: r * root.grid-cols + c;
                            property <FileRow> f: root.files[cell.idx];
                            width: root.grid-cell-w;
                            if cell.idx < root.files.length: Rectangle {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                border-radius: Theme.radius;
                                background: cell.f.selected ? (root.active ? Theme.selection : Theme.selection-inactive) : cell-touch.has-hover ? Theme.hover : transparent;
                                border-width: cell.idx == root.info.cursor && root.active && !cell.f.selected ? 1px : 0px;
                                border-color: Theme.border-strong;
                                cell-touch := TouchArea {
                                    pointer-event(e) => {
                                        if e.kind == PointerEventKind.down {
                                            root.focus-pane();
                                            if e.button == PointerEventButton.left {
                                                root.row-clicked(cell.idx, e.modifiers.control, e.modifiers.shift);
                                            } else if e.button == PointerEventButton.right {
                                                root.row-context(cell.idx);
                                                cm.show({
                                                    x: self.absolute-position.x - cm.absolute-position.x + self.mouse-x,
                                                    y: self.absolute-position.y - cm.absolute-position.y + self.mouse-y,
                                                });
                                            }
                                        }
                                    }
                                    double-clicked => { root.row-activated(cell.idx); }
                                }
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 4px;
                                    alignment: start;
                                    Rectangle {
                                        height: root.thumb-size;
                                        width: parent.width;
                                        clip: true;
                                        if cell.f.has-thumbnail: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: cell.f.thumbnail;
                                            image-fit: contain;
                                            horizontal-alignment: center;
                                        }
                                        if !cell.f.has-thumbnail: FileIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: root.icon-size;
                                            height: root.icon-size;
                                            category: cell.f.icon;
                                            large: true;
                                        }
                                    }
                                    Text {
                                        text: cell.f.name;
                                        color: cell.f.hidden ? Theme.text-faint : Theme.text;
                                        font-size: Theme.font-size-small;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 32px;
                                    }
                                }
                                if cell.f.status != 0: Dot {
                                    x: parent.width - 14px;
                                    y: 8px;
                                    tint: Theme.status-color(cell.f.status);
                                }
                            }
                        }
                    }
                }
            }

            // Empty / error / loading states.
            if root.files.length == 0: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.info.error != "" ? "Cannot open this location" : root.info.loading ? "Loading…" : root.info.filter != "" ? "No matches" : "This folder is empty";
                    color: root.info.error != "" ? Theme.bad : Theme.text-faint;
                    font-size: Theme.font-size-large;
                    horizontal-alignment: center;
                }
                if root.info.error != "": Text {
                    text: root.info.error;
                    color: Theme.text-dim;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}
