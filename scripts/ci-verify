#!/usr/bin/env bash
# Shared by GitLab CI and GitHub Actions in the pinned Arch Linux container.
set -eu

cd "$(dirname "$0")/.."

case "${1:-}" in
setup)
    # $repo and $arch are expanded by pacman.
    # shellcheck disable=SC2016
    printf '%s\n' \
        'Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch' \
        'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' \
        > /etc/pacman.d/mirrorlist
    pacman -Syu --noconfirm --needed \
        base-devel ca-certificates clang git pkgconf rust \
        libarchive fontconfig ttf-dejavu libxkbcommon wayland libx11 libxcb libxcursor \
        libxrandr libxi libxkbcommon-x11 libglvnd qt6-base \
        7zip ffmpeg zstd xz gzip bzip2 lz4 brotli
    printf '%s\n' '#if __STDC_VERSION__ < 202311L' '#error C23 required' '#endif' |
        clang -std=c23 -x c -fsyntax-only -
    id fm-test >/dev/null 2>&1 || useradd --create-home --user-group fm-test
    chown -R fm-test:fm-test "$PWD"
    ;;
check)
    exec runuser --user fm-test -- env \
        CC=clang CFLAGS=-std=c23 CARGO_HOME="$PWD/.build/cargo-home" \
        CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 \
        make test-deep-delete fmt-check check lint test CARGO_FLAGS=--locked
    ;;
*) echo "usage: $0 setup|check" >&2; exit 2 ;;
esac
