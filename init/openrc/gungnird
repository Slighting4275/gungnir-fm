#!/sbin/openrc-run
# OpenRC service script for Gungnir Virtual Filesystem Daemon (gungnird)
# Compatible with Gentoo, Alpine Linux, Artix Linux, and Devuan

name="gungnird"
description="Gungnir Virtual Filesystem Daemon"
command="${GUNGNIRD_BIN:-/usr/local/bin/gungnird}"
command_args="${GUNGNIRD_ARGS:---idle-timeout 0}"
command_user="${GUNGNIRD_USER:-${USER:-root}}"
pidfile="/run/gungnird.pid"
command_background="yes"

depend() {
    need localmount
    after bootmisc
}

start_pre() {
    checkpath -d -m 0755 -o "${command_user}" /run
}
