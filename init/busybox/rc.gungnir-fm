#!/bin/sh
# BusyBox / Toybox init script for Gungnir FM
# Place in /etc/init.d/S99gungnir-fm or run from inittab:
# ::respawn:/usr/local/bin/gungnir-fm --foreground

case "$1" in
  start)
    echo "Starting gungnir-fm..."
    start-stop-daemon -S -b -m -p /var/run/gungnir-fm.pid -x /usr/local/bin/gungnir-fm -- --foreground
    ;;
  stop)
    echo "Stopping gungnir-fm..."
    start-stop-daemon -K -p /var/run/gungnir-fm.pid
    rm -f /var/run/gungnir-fm.pid
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
