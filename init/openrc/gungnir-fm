#!/sbin/openrc-run
# OpenRC service script for Gungnir FM
# Compatible with Gentoo, Alpine Linux, Artix Linux, and Devuan

name="gungnir-fm"
description="Gungnir FM file manager background daemon"
command="${GUNGNIR_FM_BIN:-/usr/local/bin/gungnir-fm}"
command_args="${GUNGNIR_FM_ARGS:---foreground}"
command_user="${GUNGNIR_FM_USER:-${USER:-root}}"
pidfile="/run/gungnir-fm.pid"
command_background="yes"

depend() {
    need localmount
    after bootmisc
}

start_pre() {
    checkpath -d -m 0755 -o "${command_user}" /run
}
