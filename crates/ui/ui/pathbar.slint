// Nemo-style location bar: a toggle button (pencil / crumbs, also Ctrl+L) switches
// between connected breadcrumb buttons and a raw editable location that accepts
// /local/paths and gungnir://node/share/... URIs.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Crumb } from "types.slint";
import { Glyph } from "widgets.slint";

component CrumbButton inherits Rectangle {
    in property <Crumb> crumb;
    in property <bool> last;
    callback clicked;
    height: 26px;
    width: row.preferred-width;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.pressed : last ? Theme.overlay : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        Glyph {
            y: (parent.height - self.height) / 2;
            name: root.crumb.icon == 1 ? "home"
                : root.crumb.icon == 2 ? "drive"
                : root.crumb.icon == 3 ? "spear"
                : root.crumb.icon == 5 ? "trash"
                : root.crumb.icon == 6 ? "network"
                : root.crumb.icon == 11 ? "recent"
                : root.crumb.label == "Downloads" ? "download"
                : root.crumb.label == "Documents" ? "document"
                : root.crumb.label == "Music" ? "music"
                : root.crumb.label == "Pictures" ? "image"
                : root.crumb.label == "Desktop" ? "desktop"
                : "folder";
            tint: root.crumb.icon == 3 ? Theme.gold : root.last ? Theme.accent : Theme.text-dim;
        }
        if root.crumb.label != "": Text {
            text: root.crumb.label;
            color: root.last ? Theme.text : Theme.text-dim;
            font-size: Theme.font-size;
            font-weight: root.last ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PathBar inherits Rectangle {
    in property <[Crumb]> crumbs: [
        { label: "Home", uri: "/home/user", icon: 1 },
        { label: "Documents", uri: "/home/user/Documents", icon: 0 },
        { label: "project_demo", uri: "/home/user/Documents/project_demo", icon: 0 },
    ];
    in property <string> location: "/home/user/Documents/project_demo";
    in property <bool> loading: false;
    in-out property <bool> editing: false;
    callback navigate(location: string);
    callback edit-finished();

    public function start-edit() {
        root.editing = true;
        edit.text = root.location;
        edit.focus();
        edit.select-all();
    }

    function stop-edit() {
        root.editing = false;
        root.edit-finished();
    }

    height: 30px;

    HorizontalLayout {
        spacing: 4px;

        field := Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.radius;
            background: Theme.field;
            border-width: 1px;
            border-color: edit.has-focus ? Theme.accent : Theme.border;
            clip: true;

            // Connected crumbs; an overflowing path keeps its tail (current folder) visible.
            crumbs-container := Rectangle {
                visible: !root.editing;
                width: parent.width;
                height: parent.height;
                TouchArea {
                    mouse-cursor: text;
                    clicked => { root.start-edit(); }
                }
                crumb-row := HorizontalLayout {
                    x: crumb-row.preferred-width > parent.width - 4px ? parent.width - crumb-row.preferred-width - 2px : 2px;
                    y: (parent.height - self.height) / 2;
                    width: crumb-row.preferred-width;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    spacing: 0px;
                    for c[i] in root.crumbs: HorizontalLayout {
                        spacing: 0px;
                        if i > 0: Glyph {
                            y: (parent.height - self.height) / 2;
                            name: "chevron-right";
                            tint: Theme.text-faint;
                            width: 11px;
                            height: 11px;
                        }
                        CrumbButton {
                            crumb: c;
                            last: i == root.crumbs.length - 1;
                            clicked => { root.navigate(c.uri); }
                        }
                    }
                }
            }

            edit := LineEdit {
                visible: root.editing;
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                font-size: Theme.font-size;
                placeholder-text: "Path or gungnir://node/share/…";
                accepted(text) => {
                    root.stop-edit();
                    root.navigate(text);
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.stop-edit();
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if !self.has-focus && root.editing {
                        root.stop-edit();
                    }
                }
            }

            if root.loading: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                width: parent.width;
                background: Theme.accent-dim;
                Rectangle {
                    property <float> phase: Math.mod(animation-tick() / 1100ms, 1.0);
                    x: (parent.width + 80px) * phase - 80px;
                    width: 80px;
                    background: Theme.accent;
                }
            }
        }

        // Toggle between breadcrumbs and typing (Nemo's location button on the right).
        Rectangle {
            width: 30px;
            border-radius: Theme.radius-small;
            background: toggle.has-hover ? Theme.hover : root.editing ? Theme.accent-soft : transparent;
            Glyph {
                name: root.editing ? "chevron-right" : "edit";
                tint: root.editing ? Theme.accent : Theme.text-dim;
            }
            toggle := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.editing {
                        root.stop-edit();
                    } else {
                        root.start-edit();
                    }
                }
            }
        }
    }
}
