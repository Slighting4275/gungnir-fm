// Small building blocks: icons drawn as vector paths (no image assets, crisp at any
// scale), toolbar buttons, segmented buttons, badges.

import { Theme } from "theme.slint";

// File-type icon: a folder or a page with a coloured band, per category code.
export component FileIcon {
    in property <int> category: 1;
    in property <bool> large: false;
    property <color> tint: Theme.category-color(category);
    width: large ? 40px : 16px;
    height: large ? 40px : 16px;

    if category == 0: Rectangle {
        // Folder: tab + body.
        Rectangle {
            x: parent.width * 0.06;
            y: parent.height * 0.14;
            width: parent.width * 0.42;
            height: parent.height * 0.22;
            border-radius: parent.width * 0.06;
            background: tint.darker(25%);
        }
        Rectangle {
            x: parent.width * 0.06;
            y: parent.height * 0.26;
            width: parent.width * 0.88;
            height: parent.height * 0.62;
            border-radius: parent.width * 0.08;
            background: tint;
        }
    }
    if category != 0: Rectangle {
        // Page with a folded corner and a category band.
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 3 1.5 L 10 1.5 L 13.5 5 L 13.5 14.5 L 3 14.5 Z";
            fill: #c9d1dc;
            stroke: transparent;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 10 1.5 L 10 5 L 13.5 5 Z";
            fill: #8e99a8;
            stroke: transparent;
        }
        Rectangle {
            x: parent.width * 0.19;
            y: parent.height * 0.62;
            width: parent.width * 0.65;
            height: parent.height * 0.22;
            background: tint;
        }
    }
}

// Vector glyphs for buttons (16x16 viewbox, stroked).
export component Glyph inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text-dim;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: tint;
    stroke-width: 1.6px;
    fill: transparent;
    commands: name == "back" ? "M 10 3 L 5 8 L 10 13"
        : name == "forward" ? "M 6 3 L 11 8 L 6 13"
        : name == "up" ? "M 8 13 L 8 3.5 M 3.5 7.5 L 8 3 L 12.5 7.5"
        : name == "home" ? "M 2.5 7.5 L 8 2.5 L 13.5 7.5 M 4 6.5 L 4 13.5 L 12 13.5 L 12 6.5"
        : name == "refresh" ? "M 13 8 A 5 5 0 1 1 11.5 4.4 M 12 1.8 L 12 4.8 L 9 4.8"
        : name == "list" ? "M 2 4 L 14 4 M 2 8 L 14 8 M 2 12 L 14 12"
        : name == "details" ? "M 2 3.5 L 14 3.5 M 2 6.5 L 14 6.5 M 2 9.5 L 14 9.5 M 2 12.5 L 14 12.5 M 6 2 L 6 14"
        : name == "grid" ? "M 2.5 2.5 L 6.5 2.5 L 6.5 6.5 L 2.5 6.5 Z M 9.5 2.5 L 13.5 2.5 L 13.5 6.5 L 9.5 6.5 Z M 2.5 9.5 L 6.5 9.5 L 6.5 13.5 L 2.5 13.5 Z M 9.5 9.5 L 13.5 9.5 L 13.5 13.5 L 9.5 13.5 Z"
        : name == "split" ? "M 2 2.5 L 14 2.5 L 14 13.5 L 2 13.5 Z M 8 2.5 L 8 13.5"
        : name == "sidebar" ? "M 2 2.5 L 14 2.5 L 14 13.5 L 2 13.5 Z M 6 2.5 L 6 13.5"
        : name == "search" ? "M 11 11 L 14 14 M 12 7 A 5 5 0 1 1 2 7 A 5 5 0 1 1 12 7"
        : name == "close" ? "M 4 4 L 12 12 M 12 4 L 4 12"
        : name == "plus" ? "M 8 3 L 8 13 M 3 8 L 13 8"
        : name == "minus" ? "M 3 8 L 13 8"
        : name == "pause" ? "M 5.5 3.5 L 5.5 12.5 M 10.5 3.5 L 10.5 12.5"
        : name == "play" ? "M 5 3 L 12.5 8 L 5 13 Z"
        : name == "chevron-right" ? "M 6 4 L 10 8 L 6 12"
        : name == "chevron-down" ? "M 4 6 L 8 10 L 12 6"
        : name == "transfers" ? "M 4 2.5 L 4 13.5 M 1.5 11 L 4 13.5 L 6.5 11 M 12 13.5 L 12 2.5 M 9.5 5 L 12 2.5 L 14.5 5"
        : name == "desktop" ? "M 2 3 L 14 3 L 14 11 L 2 11 Z M 5.5 14 L 10.5 14 M 8 11 L 8 14"
        : name == "document" ? "M 4 1.5 L 10 1.5 L 13 4.5 L 13 14.5 L 4 14.5 Z M 6.5 8 L 10.5 8 M 6.5 11 L 10.5 11"
        : name == "download" ? "M 8 2 L 8 11 M 4.5 7.5 L 8 11 L 11.5 7.5 M 3 14 L 13 14"
        : name == "trash" ? "M 3 4.5 L 13 4.5 M 6 4.5 L 6 2.5 L 10 2.5 L 10 4.5 M 4.5 4.5 L 5.2 14 L 10.8 14 L 11.5 4.5"
        : name == "drive" ? "M 2 9 L 14 9 L 14 13.5 L 2 13.5 Z M 2 9 L 4 3 L 12 3 L 14 9 M 11 11.3 L 12 11.3"
        : name == "folder" ? "M 2 3.5 L 6.5 3.5 L 8 5 L 14 5 L 14 13 L 2 13 Z"
        : name == "music" ? "M 6 12 L 6 3.5 L 13 2 L 13 10.5 M 2.5 12 L 6 12 M 9.5 10.5 L 13 10.5"
        : name == "image" ? "M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 11 L 6 7 L 9 10 L 11 8 L 14 11"
        : name == "edit" ? "M 3 13 L 3.6 10.4 L 10.8 3.2 L 12.8 5.2 L 5.6 12.4 Z M 9.4 4.6 L 11.4 6.6"
        : name == "eject" ? "M 3 9.5 L 8 3.5 L 13 9.5 Z M 3 12.5 L 13 12.5"
        : name == "spear" ? "M 2.5 13.5 L 11.5 4.5 M 9 2 L 14 2 L 14 7 M 3.5 10 L 6 12.5"
        : "";
}

// Flat toolbar button with a glyph and an optional label.
export component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback clicked;
    width: label == "" ? 30px : (lbl.preferred-width + 34px);
    height: 28px;
    border-radius: Theme.radius-small;
    background: !enabled ? transparent : touch.pressed ? Theme.pressed : checked ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    border-width: checked ? 1px : 0px;
    border-color: Theme.accent-dim;
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        alignment: center;
        Glyph {
            y: (parent.height - self.height) / 2;
            name: root.glyph;
            tint: !root.enabled ? Theme.text-faint : root.checked ? Theme.accent : Theme.text-dim;
        }
        lbl := Text {
            visible: root.label != "";
            text: root.label;
            color: root.enabled ? Theme.text-dim : Theme.text-faint;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Pill-shaped status badge.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    height: 18px;
    width: t.preferred-width + 14px;
    border-radius: 9px;
    background: tint.with-alpha(0.16);
    border-width: 1px;
    border-color: tint.with-alpha(0.45);
    t := Text {
        text: root.text;
        color: tint.brighter(20%);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Coloured dot (mount status, VFS status).
export component Dot inherits Rectangle {
    in property <color> tint: Theme.ok;
    in property <bool> pulse: false;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tint;
    border-width: pulse ? 2px : 0px;
    border-color: tint.with-alpha(0.35);
}

// Thin progress bar.
export component Bar inherits Rectangle {
    in property <float> value: 0.0;
    in property <color> tint: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: Theme.overlay;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0.0, 1.0);
        height: parent.height;
        border-radius: 2px;
        background: root.tint;
        animate width { duration: 160ms; }
    }
}

// Nemo-style zoom control: minus button, interactive slider track, plus button, and percent reset button.
export component ZoomControl inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <float> minimum: 0.5;
    in property <float> maximum: 2.5;
    in property <float> step: 0.25;
    callback changed(float);

    height: 22px;
    width: 142px;

    function clamp-val(v: float) -> float {
        return Math.max(root.minimum, Math.min(root.maximum, v));
    }

    function set-val(v: float) {
        let rounded = Math.round(root.clamp-val(v) * 20.0) / 20.0;
        root.value = rounded;
        root.changed(root.value);
    }

    public function zoom-in() {
        root.set-val(root.value + root.step);
    }

    public function zoom-out() {
        root.set-val(root.value - root.step);
    }

    public function zoom-reset() {
        root.set-val(1.0);
    }

    HorizontalLayout {
        spacing: 3px;
        alignment: center;

        // Step down [-]
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: Theme.radius-small;
            background: minus-touch.has-hover ? Theme.hover : transparent;
            Glyph {
                name: "minus";
                width: 12px;
                height: 12px;
                tint: minus-touch.has-hover ? Theme.text : Theme.text-dim;
            }
            minus-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.zoom-out(); }
            }
        }

        // Interactive Slider Track
        track := Rectangle {
            width: 58px;
            height: 16px;

            // Track background bar
            Rectangle {
                y: (parent.height - 4px) / 2;
                height: 4px;
                border-radius: 2px;
                background: Theme.overlay;
                border-width: 1px;
                border-color: Theme.border;

                // Active fill bar
                Rectangle {
                    x: 0;
                    width: parent.width * ((root.value - root.minimum) / (root.maximum - root.minimum));
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }

            // Draggable Thumb
            thumb := Rectangle {
                x: (parent.width - self.width) * ((root.value - root.minimum) / (root.maximum - root.minimum));
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: slider-touch.has-hover || slider-touch.pressed ? Theme.accent : Theme.text-dim;
                border-width: 1px;
                border-color: Theme.border-strong;
                animate background { duration: Theme.fast; }
            }

            slider-touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        let ratio = Math.max(0.0, Math.min(1.0, self.mouse-x / parent.width));
                        root.set-val(root.minimum + ratio * (root.maximum - root.minimum));
                    }
                }
                moved => {
                    if self.pressed {
                        let ratio = Math.max(0.0, Math.min(1.0, self.mouse-x / parent.width));
                        root.set-val(root.minimum + ratio * (root.maximum - root.minimum));
                    }
                }
                double-clicked => {
                    root.zoom-reset();
                }
            }
        }

        // Step up [+]
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: Theme.radius-small;
            background: plus-touch.has-hover ? Theme.hover : transparent;
            Glyph {
                name: "plus";
                width: 12px;
                height: 12px;
                tint: plus-touch.has-hover ? Theme.text : Theme.text-dim;
            }
            plus-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.zoom-in(); }
            }
        }

        // Percentage pill & reset button (e.g. "100%")
        Rectangle {
            width: 36px;
            height: 18px;
            border-radius: Theme.radius-small;
            background: pct-touch.has-hover ? Theme.hover : transparent;
            Text {
                text: Math.round(root.value * 100) + "%";
                color: root.value == 1.0 ? Theme.text-faint : Theme.accent;
                font-size: 10px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            pct-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.zoom-reset(); }
            }
        }
    }
}
